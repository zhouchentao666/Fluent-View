/* Fluent-View - Light theme (WinUI-inspired) */

* {
    outline: none;
}

QWidget {
    background-color: #F3F3F3;
    color: #1B1B1B;
    font-size: 13px;
}

QMainWindow, #central {
    background-color: #F3F3F3;
}

/* ---------- Title bar ---------- */
#titleBar {
    background-color: #F3F3F3;
    border-bottom: 1px solid #E0E0E0;
}

#titleBarTitle {
    color: #1B1B1B;
    font-size: 12px;
    padding-left: 4px;
}

QPushButton#titleBarMin, QPushButton#titleBarMax {
    background: transparent;
    border: none;
    border-radius: 0;
}
QPushButton#titleBarMin:hover, QPushButton#titleBarMax:hover {
    background: rgba(0, 0, 0, 0.05);
}
QPushButton#titleBarClose {
    background: transparent;
    border: none;
    border-radius: 0;
}
QPushButton#titleBarClose:hover {
    background: #C42B1C;
    color: white;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #FBFBFB;
    border: 1px solid #D6D6D6;
    border-bottom-color: #C0C0C0;
    border-radius: 6px;
    padding: 6px 14px;
    color: #1B1B1B;
}
QPushButton:hover {
    background-color: #F6F6F6;
}
QPushButton:pressed {
    background-color: #F0F0F0;
}
QPushButton:checked {
    background-color: #EDEDED;
    border-color: #005FB8;
    color: #005FB8;
}
QPushButton:disabled {
    color: #9D9D9D;
    background-color: #F0F0F0;
}

QPushButton#accentButton {
    background-color: #005FB8;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}
QPushButton#accentButton:hover {
    background-color: #1A6FC0;
}

/* ---------- Floating toolbar ---------- */
#floatingToolbar {
    background-color: rgba(252, 252, 252, 242);
    border: 1px solid #D6D6D6;
    border-radius: 12px;
}
#floatingToolbar QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}
#floatingToolbar QPushButton:hover {
    background: rgba(0, 0, 0, 0.05);
}
#floatingToolbar QPushButton:pressed {
    background: rgba(0, 0, 0, 0.08);
}
#toolbarZoomLabel {
    color: #1B1B1B;
    font-size: 12px;
    background: transparent;
}
#toolbarInfoLabel {
    color: #707070;
    font-size: 12px;
    background: transparent;
    padding-right: 8px;
}

/* ---------- Panels ---------- */
#thumbnailBar, #gallerySide {
    background-color: #F7F7F7;
    border-right: 1px solid #E0E0E0;
}

#infoPanel {
    background-color: #F7F7F7;
    border-left: 1px solid #E0E0E0;
}
#infoPanelFileName {
    font-size: 15px;
    font-weight: 600;
    color: #1B1B1B;
    padding: 8px 4px;
}
#infoPanel QLabel {
    color: #3B3B3B;
    background: transparent;
}

#panelTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1B1B1B;
    padding-bottom: 8px;
}

/* ---------- Lists ---------- */
QListWidget {
    background: transparent;
    border: none;
}
QListWidget::item {
    border-radius: 6px;
    margin: 1px 2px;
    padding: 4px;
}
QListWidget::item:hover {
    background: rgba(0, 0, 0, 0.04);
}
QListWidget::item:selected {
    background: rgba(0, 95, 184, 0.12);
    color: #1B1B1B;
}

#galleryGrid {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #C4C4C4;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #B0B0B0;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

/* ---------- Gallery ---------- */
#galleryHeader {
    font-size: 20px;
    font-weight: 600;
    color: #1B1B1B;
}

/* ---------- Menus ---------- */
QMenu {
    background-color: #FCFCFC;
    border: 1px solid #D6D6D6;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: rgba(0, 0, 0, 0.06);
}
QMenu::separator {
    height: 1px;
    background: #E0E0E0;
    margin: 4px 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* ---------- Message boxes / dialogs ---------- */
QMessageBox {
    background-color: #F3F3F3;
}
QMessageBox QLabel {
    color: #1B1B1B;
    background: transparent;
}
