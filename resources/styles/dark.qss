/* Fluent-View - Dark theme (WinUI-inspired) */

* {
    outline: none;
}

QWidget {
    background-color: #202020;
    color: #F3F3F3;
    font-size: 13px;
}

QMainWindow, #central {
    background-color: #202020;
}

/* ---------- Title bar ---------- */
#titleBar {
    background-color: #202020;
    border-bottom: 1px solid #2D2D2D;
}

#titleBarTitle {
    color: #F3F3F3;
    font-size: 12px;
    padding-left: 4px;
}

QPushButton#titleBarMin, QPushButton#titleBarMax {
    background: transparent;
    border: none;
    border-radius: 0;
}
QPushButton#titleBarMin:hover, QPushButton#titleBarMax:hover {
    background: rgba(255, 255, 255, 0.06);
}
QPushButton#titleBarClose {
    background: transparent;
    border: none;
    border-radius: 0;
}
QPushButton#titleBarClose:hover {
    background: #C42B1C;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #2D2D2D;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 6px 14px;
    color: #F3F3F3;
}
QPushButton:hover {
    background-color: #353535;
}
QPushButton:pressed {
    background-color: #3A3A3A;
}
QPushButton:checked {
    background-color: #005FB8;
    border-color: #005FB8;
    color: #FFFFFF;
}
QPushButton:disabled {
    color: #777777;
    background-color: #2A2A2A;
}

QPushButton#accentButton {
    background-color: #4CC2FF;
    color: #101010;
    border: none;
    font-weight: 600;
}
QPushButton#accentButton:hover {
    background-color: #62CDFF;
}

/* ---------- Floating toolbar ---------- */
#floatingToolbar {
    background-color: rgba(43, 43, 43, 235);
    border: 1px solid #3A3A3A;
    border-radius: 12px;
}
#floatingToolbar QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}
#floatingToolbar QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
}
#floatingToolbar QPushButton:pressed {
    background: rgba(255, 255, 255, 0.12);
}
#toolbarZoomLabel {
    color: #E8E8E8;
    font-size: 12px;
    background: transparent;
}
#toolbarInfoLabel {
    color: #9D9D9D;
    font-size: 12px;
    background: transparent;
    padding-right: 8px;
}

/* ---------- Panels ---------- */
#thumbnailBar, #gallerySide {
    background-color: #1C1C1C;
    border-right: 1px solid #2D2D2D;
}

#infoPanel {
    background-color: #1C1C1C;
    border-left: 1px solid #2D2D2D;
}
#infoPanelFileName {
    font-size: 15px;
    font-weight: 600;
    color: #F3F3F3;
    padding: 8px 4px;
}
#infoPanel QLabel {
    color: #D4D4D4;
    background: transparent;
}

#panelTitle {
    font-size: 14px;
    font-weight: 600;
    color: #F3F3F3;
    padding-bottom: 8px;
}

/* ---------- Lists ---------- */
QListWidget {
    background: transparent;
    border: none;
}
QListWidget::item {
    border-radius: 6px;
    margin: 1px 2px;
    padding: 4px;
}
QListWidget::item:hover {
    background: rgba(255, 255, 255, 0.05);
}
QListWidget::item:selected {
    background: rgba(76, 194, 255, 0.20);
    color: #F3F3F3;
}

#galleryGrid {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #4A4A4A;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #5A5A5A;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: none;
}

/* ---------- Gallery ---------- */
#galleryHeader {
    font-size: 20px;
    font-weight: 600;
    color: #F3F3F3;
}

/* ---------- Menus ---------- */
QMenu {
    background-color: #2B2B2B;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 7px 24px 7px 14px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: rgba(255, 255, 255, 0.08);
}
QMenu::separator {
    height: 1px;
    background: #3A3A3A;
    margin: 4px 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

/* ---------- Message boxes / dialogs ---------- */
QMessageBox {
    background-color: #202020;
}
QMessageBox QLabel {
    color: #F3F3F3;
    background: transparent;
}
