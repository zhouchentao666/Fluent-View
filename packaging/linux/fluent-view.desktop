[Desktop Entry]
Name=Fluent View
GenericName=Image Viewer
Comment=A cross-platform Fluent Design image viewer
Exec=fluent-view %U
Icon=fluent-view
Terminal=false
Type=Application
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/webp;image/avif;image/bmp;image/gif;image/heic;image/heif;image/tiff;image/svg+xml;
StartupWMClass=fluent-view
