[Desktop Entry]
Type=Application
Name=Fluent-View
GenericName=Image Viewer
GenericName[zh_CN]=图片查看器
Comment=A Fluent Design image viewer
Comment[zh_CN]=Fluent 设计风格的图片查看器
Exec=fluent-view %F
TryExec=fluent-view
Icon=com.fluentview.FluentView
Terminal=false
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
StartupNotify=true
StartupWMClass=fluent-view
MimeType=image/jpeg;image/jp2;image/png;image/apng;image/bmp;image/gif;image/webp;image/tiff;image/x-ico;image/vnd.microsoft.icon;image/svg+xml;image/svg+xml-compressed;image/avif;image/heif;image/heic;image/x-tga;image/vnd-ms.dds;image/x-exr;image/x-portable-anymap;image/x-xcf;image/vnd.adobe.photoshop;application/pdf;image/x-eps;application/illustrator;image/x-nikon-nef;image/x-canon-cr2;image/x-canon-cr3;image/x-sony-arw;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-adobe-dng;image/x-sigma-x3f;image/x-kodak-dcr;image/x-minolta-mrw;image/x-pentax-pef;image/jxl;image/qoi;image/x-kde-raw;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Name[zh_CN]=新建窗口
